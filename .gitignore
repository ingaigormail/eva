# Secretos y datos reales: nunca al repositorio, es público.
web/data/correo.json
web/data/secret_key.txt
web/data/eva.db
web/data/sesion_activa.json
web/data/trusted_log.json
web/data/importados.json
web/data/usuarios.json*

# Espacio aéreo de ENAIRE: 7 MB que se rehacen enteros cada ciclo AIRAC.
# No es un secreto, pero versionar un binario que cambia cada 28 días
# hincha el repositorio para nada. Se regenera con web/tools/descargar_enaire.py
web/data/aeronautica.db
web/data/aeronautica.db.nuevo
web/data/reglas_config.json
web/logs/
.env
.env.*
!.env.ejemplo

# Grabaciones y configuración local del cliente: son de cada piloto.
client/grabaciones/
client/eva.config.json
client/eva-debug.log
client/eva.debug

# Construidos: se regeneran con tools/build_exe.py; 90+ MB no aportan nada
# al repo y solo lo hacen pesado de clonar.
client/build/
client/dist/
*.egg-info/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.venv/
venv/

# Datos externos y de trabajo que no son código.
/data/

# Herramientas de solo-local para arrancar/probar en el equipo del piloto;
# no tiene sentido en el servidor y no debe influir en el despliegue.
/servidor_local.bat
/servidor_local.pyw

# Permisos/ajustes locales de Claude Code: son de cada máquina, no del repo.
.claude/settings.local.json

# ==============================================================================
# EvA - Configuración de Entorno
# ==============================================================================
#
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Rellena los valores reales
# 3. Nunca hagas commit de .env (contiene secretos)
#
# ==============================================================================

# SERVIDOR WEB
# ==============================================================================
# Puerto en el que corre el servidor Flask
PORT=5055

# Modo de lanzamiento local (1=si, 0=no)
EVA_LANZAR_LOCAL=1

# Modo debug (activa auto-reload, errores detallados)
EVA_DEBUG=1

# Cookies seguras (1=HTTPS required, 0=HTTP permitido)
EVA_COOKIE_SECURE=0


# SEGURIDAD
# ==============================================================================
# Clave secreta para firmar sesiones y tokens
# NUNCA commitear esto. Generala con: python -c "import secrets; print(secrets.token_hex(32))"
EVA_SECRET_KEY=tu_clave_secreta_aqui_nunca_commitear


# CORREO SMTP
# ==============================================================================
# Modo de correo: "smtp" (real) o "memoria" (en-memoria, solo para testing)
EVA_SMTP_MODO=memoria

# Si EVA_SMTP_MODO=smtp:
# EVA_SMTP_PASSWORD=tu_contraseña_smtp_aqui
# (Usuario email: aviacionmsfs@gmail.com)


# MAILJET (alternativa al SMTP directo)
# ==============================================================================
# APIs de Mailjet (opcional, fallback a SMTP)
# MJ_APIKEY_PUBLIC=tu_clave_publica_mailjet
# MJ_APIKEY_PRIVATE=tu_clave_privada_mailjet


# DATOS EXTERNOS
# ==============================================================================
# Rutas ya consolidadas en eva/data/ (referencias):
# - Base de datos principal:        eva/web/data/eva.db
# - Aeródromos españoles:           eva/data/databases/aerodromos_es.db
# - Puntos VFR:                     eva/data/external/vfr_points/
# - Configuración de cliente:       eva/client/config/


# OLLAMA (LLM remoto, si se necesita)
# ==============================================================================
# IP y puerto del servidor Ollama en la LAN
# OLLAMA_HOST=http://192.168.x.x:11434
# (Dejar vacío si se usa localmente)


# DESARROLLO
# ==============================================================================
# Para testing, logging, etc.
# EVA_TEST_MODE=0
